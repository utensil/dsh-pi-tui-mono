{
  "name": "@dsh-pi/extensions",
  "version": "0.1.0",
  "description": "Pi extensions as dsh plugins \u2014 a thin cordis layer over pi2dsh: mounts local extension packages, exposes a mount registry, and emits TUI-bound extension events for @dsh-pi/tui.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "latest",
    "@deepseek-ai/schemastery": "latest",
    "pi2dsh": "^0.12.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "devDependencies": {
    "pi-codex-goal": "0.2.0",
    "pi-web-access": "0.23.0",
    "pi-sidequest": "1.0.2",
    "pi-boomerang": "0.7.0",
    "pi-subagents": "0.50.0",
    "pi-dynamic-workflows": "1.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6"
  }
}